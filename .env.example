# =============================================================================
# Cartographer - 環境変数テンプレート
# コピーして .env を作成してください:  cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres

# Backend から DB への接続文字列
# docker-compose 内では "db" がホスト名になります
DATABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@db:5432/postgres

# ---------------------------------------------------------------------------
# Haskell Backend
# ---------------------------------------------------------------------------
M36_DATA_PATH=/app/.m36-data

# ---------------------------------------------------------------------------
# Supabase (ローカル開発用)
# ---------------------------------------------------------------------------
# JWT Secret: PostgREST がトークンを検証するために使用
# 以下はローカル開発用のデフォルト値 (本番では使用しないこと)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ANON_KEY: 上記 JWT_SECRET で署名された role=anon のトークン
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# SERVICE_ROLE_KEY: 上記 JWT_SECRET で署名された role=service_role のトークン
# RLS をバイパスするサーバーサイド専用キー
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Supabase API URL
# docker-compose 内ではフロントエンドコンテナから supabase-gateway に接続
# (docker-compose.yml で上書きされるためここの値はブラウザからのアクセス用)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# ---------------------------------------------------------------------------
# LLM API (OpenRouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Backend API の接続先 (コンテナ間通信では "backend" を使用)
HASKELL_BACKEND_URL=http://backend:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Process Compose (Docker 不使用時のローカル開発用)
# ---------------------------------------------------------------------------
PC_PORT_NUM=9999
